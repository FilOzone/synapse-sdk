{
  "name": "filecoin-encryption-envelope",
  "version": "0.1.2",
  "description": "Filecoin Encryption Envelope: COSE envelope encryption",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilOzone/synapse-sdk.git"
  },
  "keywords": [
    "filecoin",
    "encryption",
    "cose",
    "aes-gcm"
  ],
  "license": "Apache-2.0 OR MIT",
  "bugs": {
    "url": "https://github.com/FilOzone/synapse-sdk/issues"
  },
  "homepage": "https://github.com/FilOzone/synapse-sdk/tree/master/packages/filecoin-encryption-envelope",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "src",
    "dist/src",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "pnpm run test:node && pnpm run test:browser",
    "test:node": "playwright-test \"test/**/*.test.ts\" --mode node --runner mocha",
    "test:browser": "playwright-test \"test/**/*.test.ts\" --runner mocha",
    "lint": "biome check .",
    "lint:fix": "biome check --fix ."
  },
  "dependencies": {
    "cborg": "6.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "assert": "^2.1.0",
    "mocha": "catalog:",
    "playwright-test": "^15.0.1",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
