{
  "name": "@filoz/filecoin-encryption-envelope",
  "version": "0.0.0",
  "description": "Filecoin Encryption Envelope (FIP-1253): COSE envelope encryption",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilOzone/synapse-sdk.git"
  },
  "keywords": [
    "filecoin",
    "encryption",
    "cose",
    "aes-gcm",
    "fip-1253"
  ],
  "license": "Apache-2.0 OR MIT",
  "bugs": {
    "url": "https://github.com/FilOzone/synapse-sdk/issues"
  },
  "homepage": "https://github.com/FilOzone/synapse-sdk/tree/main/packages/filecoin-encryption-envelope",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "src",
    "dist/src",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "lint": "wireit",
    "lint:fix": "biome check --fix ."
  },
  "wireit": {
    "build": {
      "command": "tsc --build --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "test": {
      "command": "mocha \"test/**/*.test.ts\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "output": [],
      "dependencies": [
        "lint"
      ]
    },
    "lint": {
      "command": "biome check .",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "../../biome.json"
      ],
      "output": [],
      "dependencies": [
        "build"
      ]
    }
  },
  "dependencies": {
    "cborg": "6.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "mocha": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
