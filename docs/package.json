{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "preview": "astro preview",
    "astro": "astro"
  },
  "wireit": {
    "build": {
      "command": "astro build",
      "files": [
        "src/**/*",
        "!src/content/docs/reference/**",
        "tooling/*/*.ts",
        "tooling/*/package.json",
        "../pnpm-lock.yaml",
        "../patches/*.patch",
        "tsconfig.json",
        "astro.config.mjs"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../packages/keysmith:build",
        "../packages/synapse-core:build",
        "../packages/synapse-sdk:build",
        "../packages/synapse-react:build"
      ]
    },
    "dev": {
      "command": "astro dev",
      "service": true,
      "files": [
        "src/**/*",
        "!src/content/docs/reference/**",
        "tooling/*/*.ts",
        "tooling/*/package.json",
        "../pnpm-lock.yaml",
        "../patches/*.patch",
        "tsconfig.json",
        "astro.config.mjs"
      ],
      "dependencies": [
        "../packages/keysmith:build",
        "../packages/synapse-core:build",
        "../packages/synapse-sdk:build",
        "../packages/synapse-react:build"
      ]
    }
  },
  "dependencies": {
    "@filoz/keysmith": "workspace:*",
    "@filoz/synapse-core": "workspace:*",
    "@filoz/synapse-react": "workspace:*",
    "@filoz/synapse-sdk": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "filecoin-encryption-envelope": "workspace:*",
    "starlight-auto-sidebar": "0.4.0",
    "starlight-changelogs": "0.6.0",
    "starlight-links-validator": "0.25.3",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/starlight": "0.41.7",
    "@filoz/docs-twoslash": "workspace:*",
    "@hugomrdias/docs": "0.2.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "7.2.4",
    "playwright": "1.64.1",
    "rehype-external-links": "3.0.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-mdn-links": "5.1.1",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "catalog:",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "wrangler": "4.125.0"
  }
}
