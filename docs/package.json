{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "preview": "astro preview",
    "astro": "astro"
  },
  "wireit": {
    "build": {
      "command": "astro build",
      "env": {
        "CHECK_LINKS": {
          "external": true
        }
      },
      "files": [
        "src/**",
        "!src/content/docs/reference/**",
        "public/**",
        "../pnpm-lock.yaml",
        "../patches/*.patch",
        "tsconfig.json",
        "astro.config.mjs"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../packages/keysmith:build",
        "../packages/synapse-core:build",
        "../packages/synapse-sdk:build",
        "../packages/synapse-react:build"
      ]
    },
    "dev": {
      "command": "astro dev",
      "service": true,
      "files": [
        "src/**",
        "!src/content/docs/reference/**",
        "public/**",
        "../pnpm-lock.yaml",
        "../patches/*.patch",
        "tsconfig.json",
        "astro.config.mjs"
      ],
      "dependencies": [
        "../packages/keysmith:build",
        "../packages/synapse-core:build",
        "../packages/synapse-sdk:build",
        "../packages/synapse-react:build"
      ]
    }
  },
  "dependencies": {
    "@filoz/keysmith": "workspace:*",
    "@filoz/synapse-core": "workspace:*",
    "@filoz/synapse-react": "workspace:*",
    "@filoz/synapse-sdk": "workspace:*",
    "@ipld/car": "5.4.7",
    "@ipld/dag-pb": "4.1.7",
    "@tanstack/react-query": "5.102.8",
    "filecoin-encryption-envelope": "workspace:*",
    "ipfs-unixfs-exporter": "15.0.4",
    "ipfs-unixfs-importer": "16.1.5",
    "multiformats": "14.0.5",
    "starlight-auto-sidebar": "0.4.0",
    "starlight-links-validator": "0.27.0",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.3.7",
    "@astrojs/starlight": "0.41.7",
    "@hugomrdias/docs": "0.2.0",
    "@shikijs/twoslash": "4.5.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "7.2.4",
    "ondine": "0.0.3",
    "sharp": "0.35.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-mdn-links": "5.1.1",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "catalog:",
    "wrangler": "4.152.0"
  }
}
